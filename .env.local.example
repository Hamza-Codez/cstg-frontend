# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser — there are
# deliberately none (IMPLEMENTATION_V2.md §2B.2 D2: the browser never calls the
# backend, so it needs no API URL).

# Backend origin. Read by next.config.ts at BUILD TIME for the /api/v1 proxy
# rewrite, and server-side by lib/api/client.ts. Changing it requires a rebuild.
API_ORIGIN=http://localhost:8000

# This app's own origin. Server Actions compare the request Origin against it
# for CSRF (lib/auth/csrf.ts). Without it every mutation fails closed.
APP_FRONTEND_ORIGIN=http://localhost:3000
